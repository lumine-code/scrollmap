{
  "name": "scrollmap",
  "author": "lumine-code",
  "description": "Show markers on the scrollbar.",
  "repository": "https://github.com/lumine-code/scrollmap",
  "bugs": {
    "url": "https://github.com/lumine-code/scrollmap/issues"
  },
  "keywords": [
    "overview-ruler",
    "gutter",
    "annotation",
    "decoration",
    "layer",
    "scrollbar"
  ],
  "version": "1.1.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../../lumine && npm run test:only -- ../pkg_lumine/scrollmap/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "marker.layer": {
      "versions": {
        "^1.0.0": "consumeMarkerLayer"
      }
    }
  },
  "providedServices": {
    "scrollmap.widget": {
      "versions": {
        "1.0.0": "provideScrollmapWidget"
      }
    }
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#a201dae6a0ea6954cb9a905be4a718af697d9f78",
    "@lumine-code/marker-host": "file:../../pkg_nodejs/marker-host"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "disabledLayers": {
      "title": "Disabled Layers",
      "description": "List of disabled layer names",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "overlayWidth": {
      "title": "Overlay Width",
      "description": "Width of the strip, in pixels, on platforms whose scrollbars float over the content and reserve no space of their own — macOS, and Linux with overlay scrollbars. Where the scrollbar does reserve space the strip matches it and this is unused.",
      "type": "number",
      "minimum": 0,
      "default": 8
    },
    "thresholdScale": {
      "title": "Threshold Scale",
      "description": "Multiplies every layer's own marker limit before it decides to draw nothing. Raise it to keep noisy layers visible on the strip.",
      "type": "number",
      "minimum": 0,
      "default": 1
    }
  }
}
