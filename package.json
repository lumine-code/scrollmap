{
  "name": "scrollmap",
  "author": "lumine-code",
  "description": "Show markers on the scroll bar",
  "repository": "https://github.com/lumine-code/scrollmap",
  "bugs": {
    "url": "https://github.com/lumine-code/scrollmap/issues"
  },
  "keywords": [
    "scrollmap"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../scrollmap/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "scrollmap": {
      "versions": {
        "^1.0.0": "consumeScrollmap"
      }
    }
  },
  "providedServices": {
    "simplemap": {
      "versions": {
        "1.0.0": "provideSimplemap"
      }
    }
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#fbbc2d9660db6a2ff676c7a3baf7536f96ec34e6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "disabledLayers": {
      "title": "Disabled Layers",
      "description": "List of disabled layer names",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
