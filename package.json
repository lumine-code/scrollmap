{
  "name": "scrollmap",
  "author": "lumine-code",
  "description": "Show markers on the scrollbar.",
  "repository": "https://github.com/lumine-code/scrollmap",
  "bugs": {
    "url": "https://github.com/lumine-code/scrollmap/issues"
  },
  "keywords": [
    "overview-ruler",
    "gutter",
    "annotation",
    "decoration",
    "layer",
    "scrollbar"
  ],
  "version": "1.1.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../scrollmap/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "scrollmap.layer": {
      "versions": {
        "^1.0.0": "consumeScrollmapLayer"
      }
    }
  },
  "providedServices": {
    "scrollmap.widget": {
      "versions": {
        "1.0.0": "provideScrollmapWidget"
      }
    }
  },
  "dependencies": {
    "@lumine-code/select-list": "https://github.com/lumine-code/select-list.git#a201dae6a0ea6954cb9a905be4a718af697d9f78"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  },
  "configSchema": {
    "disabledLayers": {
      "title": "Disabled Layers",
      "description": "List of disabled layer names",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
